# Copy this file to .env before running `docker compose up`.
# These values are for local development only.

# Postgres superuser, used only by the init script
POSTGRES_PASSWORD=postgres

# Airflow metadata database
AIRFLOW_DB_PASSWORD=airflow

# Pokemon database: the DAG writes with the loader, the API reads with the api user
POKEMON_LOADER_PASSWORD=loader
POKEMON_API_PASSWORD=api
